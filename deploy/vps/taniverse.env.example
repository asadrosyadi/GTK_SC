# /etc/taniverse/taniverse.env -- dibaca oleh taniverse-rnn.service dan taniverse-detect.service
# Salin: sudo install -D -m 640 deploy/vps/taniverse.env.example /etc/taniverse/taniverse.env

# Zona waktu proses Python: jam deteksi kamera (DETECT_HOURS) dan created_at hasil deteksi
# harus WIB, sama dengan APP_TIMEZONE Laravel.
TZ=Asia/Jakarta

# Database (sama dengan backend/laravel/.env)
MYSQL_HOST=127.0.0.1
MYSQL_USER=taniverse
MYSQL_PASSWORD=ganti-password-db
MYSQL_DB=padi_sawah

# Perangkat (users.iot_id) dan endpoint riwayat sensor Laravel untuk layanan rnn
IOT_ID=jTZids5M
# Ganti domain dengan domain VPS Anda. Jangan menaruh komentar di ujung baris (systemd
# membaca seluruh sisa baris sebagai nilai).
HISTORY_URL=https://petaniasik.my.id/api/sensor?iot_id=jTZids5M

# Layanan Python hanya mendengar localhost; ESP32 dan browser lewat Laravel (nginx :443)
RNN_HOST=127.0.0.1
RNN_PORT=5000
DETECT_HOST=127.0.0.1
DETECT_PORT=7000

# Deteksi kamera
DETECT_HOURS=6-23
CAMERAS=
FULL_FRAME_FALLBACK=1
HAMA_PADI_DIR=/var/www/taniverse/backend/html/img/hama_padi

# Server tanpa GPU: sembunyikan pencarian CUDA
CUDA_VISIBLE_DEVICES=-1
